# Prompt Forge works with zero configuration via its built-in local engine.
# Add any LLM key below to get model-quality forging instead.
#
# Engine precedence when several keys are set:
#   OpenRouter → Gemini → Anthropic → Ollama → local
# Force a specific engine with FORGE_ENGINE (openrouter | gemini | anthropic | ollama | local).

# OpenRouter — one key, access to many models (https://openrouter.ai)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openrouter/auto

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
# GOOGLE_API_KEY=AIza...
# (GEMINI_API_KEY is also accepted as an alias)
# GEMINI_MODEL=gemini-2.0-flash

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# FORGE_ENGINE=openrouter

# PORT=3001
# OLLAMA_URL=http://localhost:11434   # used automatically if Ollama is running
